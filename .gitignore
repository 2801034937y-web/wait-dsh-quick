# ============================================================
#  wait-dsh-quick  .gitignore
#  目的：防止敏感内容与运行时产物被提交到公开仓库
# ============================================================

# ------------------------------------------------------------
# 1) 敏感凭据（最高优先级）—— 一旦提交就很难彻底删除
# ------------------------------------------------------------
# DSH 启动器运行期间会把会话 cookie / 状态写到
#   %LOCALAPPDATA%\dsh-launcher\
# 即项目目录之外。以下是「万一将来运行目录被移进项目里」的兜底防护。
session-cookie.txt
server.json
server-output.txt
shortcut-name.txt
start-server.cmd

# 常见凭据文件
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12
credentials*
.credentials*
*credentials.yaml
*credentials.yml

# DSH 自身的会话/配置目录（绝不上传）
.dsh/

# ------------------------------------------------------------
# 2) 运行时产物
# ------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.cache

# ------------------------------------------------------------
# 3) 构建产物
# ------------------------------------------------------------
build/
dist/
out/
bin/
obj/
node_modules/
*.exe
*.dll
*.sys
*.o
*.obj
*.pdb

# ------------------------------------------------------------
# 4) 编辑器 / IDE
# ------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ------------------------------------------------------------
# 5) 操作系统垃圾
# ------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
desktop.ini
